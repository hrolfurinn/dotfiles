#!/bin/sh
# Focus the iTerm2 window, tab and split attached to tty $1 (e.g. /dev/ttys003).
# With no argument, just bring iTerm2 to the front.
[ -n "$1" ] || exec open -a iTerm

exec osascript - "$1" <<'APPLESCRIPT'
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    activate
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if tty of s is target then
            select w
            select t
            select s
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
