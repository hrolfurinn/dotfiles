#!/bin/sh
# Select tmux pane $1 and focus the terminal showing it.
# With no pane, just bring the terminal to the front.
pane=$1
tty=

if [ -n "$pane" ]; then
  tmux select-window -t "$pane"
  tmux select-pane -t "$pane"
  session=$(tmux display-message -p -t "$pane" '#{session_id}')
  tty=$(tmux list-clients -t "$session" -F '#{client_tty}' | head -n 1)
fi

exec iterm-focus-tty "$tty"
